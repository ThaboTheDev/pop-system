{
  "name": "pop-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:seed": "psql \"$DATABASE_URL\" -f supabase/seed/seed.sql",
    "create:admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "test:operations": "node scripts/test-operations.mjs",
    "preview:css": "node scripts/inline-preview-css.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.5.25",
    "pdf-lib": "^1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
